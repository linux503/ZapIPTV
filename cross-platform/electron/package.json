{
  "name": "zapiptv",
  "productName": "ZapIPTV",
  "version": "2.0.2",
  "description": "亞洲影視與直播應用 — Windows",
  "main": "main.js",
  "author": "ZapIPTV",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --universal"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zapiptv.app",
    "productName": "ZapIPTV",
    "directories": { "output": "dist" },
    "files": ["main.js", "web/**/*"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "ZapIPTV-${version}-win-x64.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "category": "public.app-category.entertainment"
    },
    "portable": { "artifactName": "ZapIPTV-${version}-win-x64.${ext}" }
  }
}
